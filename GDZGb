name: Build APK
on:
  workflow_dispatch:
  push:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Descomprimir proyecto
        run: unzip -q GBPort.zip
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: android-actions/setup-android@v3
      - name: Instalar NDK y CMake
        run: sdkmanager "ndk;26.1.10909125" "cmake;3.22.1"
      - name: Compilar
        working-directory: GBPort
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: GBPlayer-APK
          path: GBPort/app/build/outputs/apk/debug/*.apk
